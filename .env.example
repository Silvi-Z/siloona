## Copy to .env.local and fill in from your Supabase project's
## Settings → API page. Run supabase/schema.sql in that project's SQL
## editor first — the app will show a setup screen until both exist.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

## ---------------------------------------------------------------------
## Orders & payments — SERVER ONLY. Never add a VITE_ prefix to these:
## anything prefixed VITE_ is shipped to every visitor's browser.
## On Vercel, set them under Project → Settings → Environment Variables.
## Run supabase/payments.sql (after schema.sql) before turning these on.
## ---------------------------------------------------------------------

# Supabase → Settings → API → service_role key. Lets /api write orders.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The public address of the site, used to build the bank's return URLs.
# Required in production, e.g. https://siloona.vercel.app
PUBLIC_SITE_URL=

# ArCa vPOS (card payments) — issued by your acquiring bank.
# Start with ARCA_MODE=test and the bank's test credentials; switch to
# live with the live credentials once the bank has certified the shop.
ARCA_USERNAME=
ARCA_PASSWORD=
ARCA_MODE=test
# Optional: ARCA_API_BASE=  (full REST base, if the bank gives another host)
# Optional: ARCA_AMOUNT_MULTIPLIER=100  (minor units per dram — confirm with the bank)
# Give the bank this callback URL if they offer payment notifications:
#   <PUBLIC_SITE_URL>/api/payments/arca/callback

# Payment SIMULATOR: adds a «Թեստային վճարում» method whose stand-in bank
# page lets you choose paid / declined / cancelled. No money moves; orders
# are marked «Թեստ» in the dashboard and kept out of revenue. For local
# testing and preview deployments only — never on the public live site.
PAYMENTS_SIMULATION=

# Idram merchant account. In the Idram merchant settings set:
#   RESULT_URL  = <PUBLIC_SITE_URL>/api/payments/idram/result
#   SUCCESS_URL = <PUBLIC_SITE_URL>/checkout/result?via=idram
#   FAIL_URL    = <PUBLIC_SITE_URL>/checkout/result?via=idram
IDRAM_ACCOUNT_ID=
IDRAM_SECRET_KEY=

# --- Notifications (optional) ------------------------------------------------
# Telegram message to Siloona on every new order, custom-design request,
# payment and refund. Create a bot with @BotFather, send it a message (or add
# it to a group), and put the chat id here. Leave empty to turn off.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Rate limiting -------------------------------------------------------------
# On by default for the public endpoints (orders, photo uploads, RSVPs, invitation
# page loads) — needs supabase/guest-links.sql. Only the local test suite and
# demo set RATE_LIMITS=off. Never turn it off on the live site.
# RATE_LIMITS=off
